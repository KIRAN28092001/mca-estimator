{
  "name": "mca-estimator",
  "version": "0.1.0",
  "private": true,
  "description": "MC Aquatic estimating software — cost codes, assemblies, multi-pool estimates, markups, SOV and proposals",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "seed": "node server/seed.js --reset",
    "migrate:csi": "node server/migrate-csi.js",
    "backup": "node server/backup.js",
    "test": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2"
  }
}
